# Copia questo file in `keystore.properties` e compila con i tuoi valori.
# `keystore.properties` e il file .jks NON vengono committati (vedi .gitignore).
#
# Genera un keystore di release con:
#   keytool -genkeypair -v -keystore mensis-release.jks -alias mensis \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Senza questo file la build di release ripiega automaticamente sulla firma di debug.

storeFile=mensis-release.jks
storePassword=CAMBIA_ME
keyAlias=mensis
keyPassword=CAMBIA_ME
